{"legislative_session": "119", "identifier": "HR 11050", "title": "Support Through Loss Act", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [], "other_titles": [{"note": "", "title": "To allow Americans to receive paid leave time to process and address their own health needs and the health needs of their partners during the period following a pregnancy loss, an intrauterine insemination or an assisted reproductive technology procedure that did not result in a live birth, a stillbirth, a failed adoption arrangement, a failed surrogacy arrangement, or a diagnosis or event that impacts pregnancy or fertility, to support related research and education, and for other purposes."}], "other_identifiers": [{"identifier": "ocd-bill-us-119-hr11050"}], "actions": [{"description": "Introduced in House", "date": "2026-11-17T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "Referred to the Committee on Education and Workforce, and in addition to the Committees on House Administration, Oversight and Government Reform, the Judiciary, and Energy and Commerce, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned.", "date": "2026-11-17T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}], "sponsorships": [{"name": "Yassamin Ansari", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Yassamin Ansari\"}", "organization_id": null}, {"name": "Salud O. Carbajal", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Salud O. Carbajal\"}", "organization_id": null}, {"name": "Judy Chu", "classification": "cosponsor", "entity_type": "p